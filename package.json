{
  "name": "gavelock",
  "private": true,
  "version": "0.1.0",
  "description": "Tamper-proof tenders and quote requests on X Layer.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:fork": "npm run test:fork -w @gavelock/contracts"
  },
  "engines": {
    "node": ">=22"
  }
}
